# ==============================================================================
# PersonaPulse Elite - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and add your keys.
# Next.js automatically loads .env.local on startup.

# 1. Google Gemini API Key (100% Free - 1,500 requests/day)
# Get your free key in 30 seconds at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Google PageSpeed & CrUX API Key (Optional - 25,000 queries/day)
# The app works out of the box without this, but adding a free key provides dedicated quota.
# Get free key at: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# 3. PostHog Live Analytics (Optional - for testing your own live website)
# 1,000,000 events/month free forever: https://posthog.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com
